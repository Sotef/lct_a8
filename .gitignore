# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
.venv-mcp/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/
jupyter_cloud_config.yaml

# Данные СМВУ: тяжёлые выгрузки (~16 ГБ) в git не кладём
research/dataset/
*.7z
# крупные архивы данных (например research/dataset.zip ~4.8 ГБ) — тоже вне git
research/*.zip
# ...но справочники нужны сервису для bootstrap (objects_ref/channels_ref) — коммитим
!research/dataset/
research/dataset/*
!research/dataset/справочник_каналов_датчиков.csv
!research/dataset/справочник_объектов_диспетчер.csv
# Полная пересборка остального: см. research/docs/REPRODUCE_DATASETS.md

# ML artifacts
*.onnx
research/models/
research/parquet/
# ...кроме обученных моделей: без них сервис стартует, но не делает прогнозы
!research/models/
research/models/*
!research/models/tte_*_discrete_hazard.cbm
!research/models/calib30_*.pkl

# CatBoost training telemetry (auto-generated, regenerable)
catboost_info/

# Services: runtime-heavy кэши в git не кладём (панели ~319 МБ, SQLite ~8 ГБ),
# НО raw-кэш 2026 (1.1 МБ) коммитим: панель 6ч пересобирается из него на первом запуске
services/data/panels/
services/data/*.db
services/data/raw/
!services/data/raw/
services/data/raw/*
!services/data/raw/buckets_2026.parquet
# каталог живой подачи (SIM_FEED=1): кэш/панели, которые сервис строит сам
services/data/stream/
# генерируемые отчёты прогонов (тесты кнопок/E2E)
services/data/buttons_api_report.md
services/data/e2e_report.md
services/data/*.db-*
services/.venv/
services/*.log

# IDE / OS
.vscode/
.mcp.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
D:/temp/
services/logs/
services/data/_web_backup/

# --- Docker / TLS (локальные секреты и логи развёртывания) ---
.env
services/.env
services/deploy/certs/*.key
services/deploy/certs/*.crt
services/docker_build*.log
services/docker_up.log
services/data/_*.txt
services/data/_*.log
services/data/attachments/
