# Шаблон для `docker compose` (PostgreSQL + API).
# Скопируйте в `services/.env` и при необходимости поправьте:
#   copy .env.docker.example .env      # Windows
#   cp   .env.docker.example .env      # bash
#
# Compose читает этот файл ТОЛЬКО для подстановки ${VAR} в docker-compose.yml.
# В контейнер значения попадают из блока `environment` (см. docker-compose.yml),
# поэтому Windows-пути из dev-`.env` сюда лучше не переносить.

# --- Порты на хосте ---
API_PORT=8000
HTTPS_PORT=8443
HTTP_PORT=8080
POSTGRES_PORT=5432

# --- PostgreSQL 12+ (в compose образ 14-alpine) ---
POSTGRES_USER=moscollector
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moscollector

# --- Безопасность (ОБЯЗАТЕЛЬНО поменять в проде) ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MOBILE_REFRESH_DAYS=30
LOGIN_RATE_LIMIT=20

# --- Логи ---
LOG_LEVEL=INFO
LOG_JSON=1
LOG_BUFFER_SIZE=3000
LOG_FILE_MAX_MB=20
LOG_FILE_BACKUPS=5
SLOW_REQUEST_MS=1500

# --- Демо-прокрут данных 2026 (симулированные часы) ---
# SIM_CLOCK=1 — «сейчас» сервиса = симулированное время, +6 ч каждые SIM_TICK_REAL_SEC
SIM_CLOCK=1
SIM_YEAR=2026
SIM_START=2026-01-01T00:00:00
SIM_TICK_REAL_SEC=75
SIM_LOOP=1
# RUN_SCHEDULER=1 — классический 6ч-цикл по реальному времени (только при SIM_CLOCK=0)
RUN_SCHEDULER=0
# SHAP-факторы «почему»: 400 каналов ≈ 43 с на задачу; 0 — быстрый расчёт без SHAP
SHAP_TOP_K=400

# --- Живая подача из журнала: «как в реальной работе» (без предзагруженной панели) ---
# SIM_FEED=1 — на каждом тике сервис сам читает НОВЫЙ ХВОСТ грязного ext-journal-*.csv,
# агрегирует его в data/stream/raw, пересобирает признаки/панель из накопленного кэша
# и инференсит текущий бакет (см. services/README.md → «Живая подача»).
# Требует примонтированный research/dataset/extracted/ext-journal-<SIM_YEAR>.csv.
SIM_FEED=0
# Читать журнал порциями по N строк (ленивое чтение, без повторного прохода файла)
SIM_FEED_CHUNK=200000
# Конец периода подачи (ISO). Пусто — определяется по последней строке журнала.
SIM_FEED_END=
# Пересобирать признаки на каждом тике (для подачи обязательно)
SIM_FEED_REBUILD=1
# Дочитать журнал до SIM_START перед первым прогнозом (чтобы признаки были «тёплыми»)
SIM_FEED_WARMUP=1

# --- Превентивные заявки ---
AUTO_TICKETS=1
AUTO_TICKETS_MIN_RISK=0.5
AUTO_TICKETS_TOP_K=15

# --- Мобильный профиль / PWA ---
PWA=1
ALERTS_PUSH=1
ALERTS_MIN_P7D=0.2
ALERTS_SILENCE_HOURS=12
ALERTS_TOP_K=50
ATTACH_MAX_MB=5

# --- Web Push (VAPID). Пусто -> push-подписка сохраняется, рассылка выключена
# (клиент работает на фолбэк-поллинге GET /alerts). Требуется HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ods@moscollector.ru

# --- Демо-данные 2026: авто-подтяг на старте контейнера ---
# Если чего-то из панелей/артефактов не хватает, entrypoint сам скачает архив
# demo-data-2026.zip и распакует его в /workspace (том ./data виден на хосте).
# Порядок: сначала DEMO_DATA_HF, иначе DEMO_DATA_URL.
DEMO_DATA_HF=sotef/moscollector-2026-demo-data
DEMO_DATA_URL=
DEMO_DATA_SHA256=
# таймаут сети на скачивание, с (нет сети/приватный датасет -> фолбэк на пересборку из raw)
DEMO_DATA_TIMEOUT=60
# SKIP_DEMO_FETCH=1 — на старте вообще не ходить в сеть
SKIP_DEMO_FETCH=0

# --- Поведение entrypoint ---
SKIP_SEED=0
RUN_MIGRATIONS=0
DB_WAIT_RETRIES=45

# --- Прочее ---
IMAGE_TAG=latest
