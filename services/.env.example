# --- Данные/пути ---
# Абсолютный путь к папке research (research-модули: features, tte_pipeline, inference_contract)
RESEARCH_DIR=d:\Downloads_D\lct_a8\research
# Папка журналов СМВУ (read-only источник)
# EXTRACTED_DIR=d:\Downloads_D\lct_a8\research\dataset\extracted
# Файл-источник потоковой подачи (тест: только 2026, не использовался в обучении)
STREAM_SOURCE=d:\Downloads_D\lct_a8\research\dataset\extracted\ext-journal-2026.csv

# --- БД ---
# Локальная разработка (по умолчанию): SQLite в services/data/app.db
DATABASE_URL=sqlite:///d:/Downloads_D/lct_a8/services/data/app.db
# Прод (PostgreSQL 12+):
# DATABASE_URL=postgresql://moscollector:password@localhost:5432/moscollector
# DB_ECHO=0

# --- Безопасность ---
# В проде обязательно поменять! ACCESS 30 мин / REFRESH 7 сут
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Попыток входа на 5 минут (защита от brute-force)
LOGIN_RATE_LIMIT=20
# TLS: termination на reverse-proxy (nginx/caddy) или \u2014 ключи Uvicorn

# --- Сервис ---
HOST=127.0.0.1
# HOST=0.0.0.0 — сервис доступен из локальной сети (адрес вида http://<IP>:8000; см. scripts/serve.py)
PORT=8000
# Фоновый планировщик пересчёта прогнозов каждые 6ч при SIM_CLOCK=0 (1 — включён)
RUN_SCHEDULER=0

# --- Симулируемые часы (режим реплея данных 2026 года) ---
# «Сейчас» сервиса = симулированное время: старт 2026-01-01 00:00, каждые
# SIM_TICK_REAL_SEC секунд реального времени +6ч сим-времени и пересчёт всех
# 4 задач (прогнозы попадают в сезонность моделей). Состояние — settings.sim_bucket.
SIM_CLOCK=1
SIM_START=2026-01-01T00:00:00
SIM_TICK_REAL_SEC=75
# SIM_LOOP=1: дойдя до конца периода (июнь 2026), реплей начинается заново с SIM_START
# (прогнозы/решения/заявки предыдущего круга сбрасываются) — демонстрация не останавливается.
SIM_LOOP=1
# Скорость демо-прокрута (управляется из UI: Система → Обзор, уровни 1×/2×/4×/8×):
# SHAP — самое дорогое место тика (~43 с на задачу при SHAP_TOP_K=400, тик ~2 мин);
# «быстрый расчёт» в UI отключает SHAP и ускоряет тик в ~100 раз.
SHAP_TOP_K=400

# --- Логирование ---
# Каталог логов (JSON lines + ротация) и кольцевой буфер для live-просмотра в UI
LOG_DIR=d:\Downloads_D\lct_a8\services\logs
LOG_LEVEL=INFO
LOG_JSON=1
LOG_FILE_MAX_MB=20
LOG_FILE_BACKUPS=5
LOG_BUFFER_SIZE=3000
# Запрос дольше порога попадает в лог уровнем WARNING
SLOW_REQUEST_MS=1500

# --- Автоформирование превентивных заявок (см. README §8) ---
AUTO_TICKETS=1
# Единый порог (fallback). Если задан — используется для всех направлений.
# Если НЕ задан — берётся AUTO_TICKETS_MIN_RISK_BY_TASK (разная шкала у моделей).
#AUTO_TICKETS_MIN_RISK=0.5
AUTO_TICKETS_MIN_RISK_BY_TASK={"fire": 0.30, "access": 0.45, "sensor": 0.45, "wear": 0.50}
# Опорная тяжесть последствия: eff = base * (ref / severity) — тяжёлые типы заводятся раньше
AUTO_TICKETS_SEVERITY_REF=0.6
# Ёмкость: новых заявок за тик и максимум открытых near-term (текущий+следующий квартал) на направление
AUTO_TICKETS_TOP_K=60
AUTO_TICKETS_NEAR_CAP=500
# План ТО: не двигать срок открытой suggested-заявки при сдвиге меньше N дней (анти-прыжки)
PLAN_HYSTERESIS_DAYS=5
# Потолок прогнозного срока (дней) в date = min(прогноз, норматив)
PLAN_FORECAST_CAP_DAYS=90

# --- Живая подача данных из журнала («как в реальной работе», см. services/README.md) ---
# SIM_FEED=1 — на каждом тике сервис сам читает хвост грязного ext-journal-*.csv,
# агрегирует в data/stream/raw, пересобирает признаки/панель и инференсит текущий бакет
SIM_FEED=0
SIM_FEED_CHUNK=200000
SIM_FEED_END=
SIM_FEED_REBUILD=1
SIM_FEED_WARMUP=1
# Год журнала (файл ext-journal-<год>.csv)
SIM_YEAR=2026

# --- Мобильная версия / PWA (MOBILE_PLAN §6.2) ---
# PWA=1 — отдавать manifest/service worker и включать клиентские мобильные фичи
PWA=1
# Серверное правило алертов (перенос «тишины» notify.js на сервер) + рассылка
ALERTS_PUSH=1
ALERTS_MIN_P7D=0.2
ALERTS_SILENCE_HOURS=12
ALERTS_TOP_K=50
# AUTH_COOKIE_REFRESH=1 — refresh-токен в HttpOnly cookie (опционально)
AUTH_COOKIE_REFRESH=0
# Срок жизни refresh-токена на телефоне (дни)
MOBILE_REFRESH_DAYS=30

# --- Web Push (VAPID) ---
# Сгенерировать: python -c "from py_vapid import Vapid; Vapid().save_key('vapid.pem')" (нужны pywebpush/py-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ods@moscollector.ru

# --- Вложения (фото с объекта) ---
# ATTACH_DIR=d:\Downloads_D\lct_a8\services\data\attachments
ATTACH_MAX_MB=5